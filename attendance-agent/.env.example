# Copy this file to .env and fill in real values. .env itself is
# git-ignored — never commit it (it holds a secret key).

# ZKTeco K70, device #1 (e.g. Karachi). Can be on the office LAN
# (192.168.x.x) or reachable over the internet (a public IP) — either
# works, the agent doesn't care, it just needs to be able to reach it.
DEVICE_IP=192.168.30.64
DEVICE_PORT=4370
# Optional — only used for clearer log lines, e.g. "[Karachi] Pushed 1 punch(es)".
DEVICE_NAME=Karachi

# A second (or third, fourth, ...) K70 at another office — one process
# polls all of them. Just add more DEVICE_2_*, DEVICE_3_*, ... blocks; you
# never need to touch the DEVICE_IP/DEVICE_PORT lines above for this.
# Each device gets its own independent "last synced" tracking file
# (state.json for device 1, state-<name>.json for the rest), so adding a
# new device can never affect an already-running one.
#DEVICE_2_NAME=Islamabad
#DEVICE_2_IP=182.180.59.128
#DEVICE_2_PORT=4370

# How often to poll the device(s) for new punches (seconds) — applies to all of them.
POLL_INTERVAL_SECONDS=20

# Premier ERP backend base URL (the same backend erp-ptis-complete/backend
# runs) and the shared secret from its ATTENDANCE_AGENT_KEY env var.
BACKEND_URL=https://erp.ptis.co
AGENT_KEY=CHANGE-ME-same-value-as-backend-ATTENDANCE_AGENT_KEY

# Leave this line out (or blank) — the agent asks the K70 itself what time
# it thinks it is every poll and auto-corrects any clock error, no manual
# number needed. Only set TIME_OFFSET_HOURS if that auto-detect ever turns
# out unreliable and you need to force a fixed correction instead, e.g.:
# TIME_OFFSET_HOURS=12

# These two only matter on a device's very FIRST run (i.e. no state.json /
# state-<name>.json for it yet) — they decide what happens to punches
# already sitting on the device before the agent ever talked to it:
#   - neither set (default): nothing existing is imported, only punches
#     from this point forward.
#   - BACKFILL_ALL=true: import literally everything already on the device.
#   - BACKFILL_SINCE=YYYY-MM-DD: import only from that date onward (e.g.
#     "give me attendance from 21 August onward" -> BACKFILL_SINCE=2026-08-21).
#     Ignored if BACKFILL_ALL is also set to true.
# BACKFILL_ALL=true
# BACKFILL_SINCE=2026-08-21
