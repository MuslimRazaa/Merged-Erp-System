PORT=5050
HOST=0.0.0.0
NODE_ENV=development

# ── Same MySQL database as the ISO/LMS backend (iso-server-backend-PTIS) ──
# This backend only ever reads existing tables and creates its own new
# erp_-prefixed tables (see migrate.js). It never runs ALTER TABLE on any
# ISO table, so iso-server-backend-PTIS is unaffected no matter what
# happens here.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ptis_erp_db

# HMAC signing key for ERP session tokens (separate from ISO's own auth).
# Set a real random value in production, e.g.: openssl rand -base64 48
JWT_KEY=change-me
TOKEN_TTL_HOURS=12

# Comma-separated list of origins allowed to call this API cross-domain.
# Needed because the ERP frontend will be hosted on its own separate domain.
# Example: CORS_ORIGIN=https://erp.premiertubular.com
CORS_ORIGIN=*

# Shared secret the ZKTeco attendance-agent (attendance-agent/, running on
# the office VM) uses to call POST /api/attendance/ingest. Not a human
# login — put the SAME value in attendance-agent/.env's AGENT_KEY.
# Generate a real one for production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATTENDANCE_AGENT_KEY=change-me

# ── Outgoing mail (Payroll / Slips → Send Payslips) ──
# Whatever SMTP account actually sends these — a real company mailbox
# (Outlook/Office365, Google Workspace) or a transactional provider
# (SendGrid, Mailgun, Amazon SES). Standard nodemailer SMTP fields; no
# code change needed to switch provider, just these values.
# Office365 example: SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_SECURE=false
# Gmail/Workspace example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true
#   (Gmail needs an App Password, not the account's normal login password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# What recipients see as the From name/address — defaults to SMTP_USER if left blank.
SMTP_FROM=